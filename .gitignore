# Anything inside a package directory is a build artefact or a downloaded source
# unless listed below. An allowlist is used because the previous blocklist had to
# enumerate every possible source extension and silently leaked whatever it
# missed, such as downloaded AppImages.
packages/*/*
!packages/*/PKGBUILD
!packages/*/*.install
# SPDX LicenseRef- identifiers need their licence text shipped from the package
# directory, since by definition no /usr/share/licenses/common file covers them.
!packages/*/LicenseRef-*
!packages/*/*.patch
!packages/*/*.desktop
!packages/*/*.hook
!packages/*/*.sysusers
!packages/*/*.tmpfiles
